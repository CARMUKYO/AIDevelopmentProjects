# Server Configuration
PORT=8080
BASE_URL=http://localhost:8080
SERVER_DOMAIN=localhost:8080

# Database Configuration
# Use "sqlite" for lightweight local dev/testing or "postgres" for production
DB_DRIVER=sqlite
DATABASE_URL=file:urlshortener.db?cache=shared&mode=rwc

# For PostgreSQL:
# DB_DRIVER=postgres
# DATABASE_URL=postgres://shortener:shortener_pass@localhost:5432/shortener_db?sslmode=disable

# Cache & Buffer Configuration (Optional: leave empty to use in-memory cache)
# REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_BURST=10

# Workers
FLUSH_INTERVAL_SEC=5
CLEANER_INTERVAL_HR=24
